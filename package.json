{
  "name": "syntax",
  "description": "Full Stack Developers Wes Bos and Scott Tolinski dive deep into web development topics, explaining how they work and talking about their own experiences. They cover from JavaScript frameworks like React, to the latest advancements in CSS to simplifying web tooling.",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/build-css.mjs",
    "dev": "next dev --port 6969",
    "prebuild": "node scripts/build-css.mjs",
    "build": "next build",
    "start": "serve out --listen 6969",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "meta-marked": "^0.5.0",
    "next": "^15.5.22",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hls-player": "^3.0.7",
    "react-icons": "^5.7.0",
    "speakingurl": "^14.0.1"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "serve": "^14.2.6",
    "stylus": "^0.64.0",
    "typescript": "^5.9.3"
  }
}
